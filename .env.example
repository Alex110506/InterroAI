# Copy to `.env` (repo root, gitignored) and fill in the blanks.
#
# docker compose reads this file for the local stack; the Cloud API, the worker
# and the local runtime read the INTERROAI_* values through pydantic-settings.

# ── Local stack (docker compose) ─────────────────────────────────────────────
# These containers only ever run on your machine; choose any values.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=interroai
# Password for the non-superuser role the API and worker connect as.
INTERROAI_APP_DB_PASSWORD=
# SQL Server (the Service Bus emulator's storage) enforces a strong password:
# at least 8 characters with upper case, lower case, a digit and a symbol.
MSSQL_SA_PASSWORD=
# Set to Y only after reading and accepting both licences:
#   Service Bus emulator: https://github.com/Azure/azure-service-bus-emulator-installer/blob/main/EMULATOR_EULA.txt
#   SQL Server on Linux:  https://go.microsoft.com/fwlink/?LinkId=746388
ACCEPT_EULA=N

# ── Cloud API and worker ─────────────────────────────────────────────────────
# The app role (row-level security applies) and the owner (migrations only).
# Substitute the two passwords from above.
INTERROAI_DATABASE_URL=postgresql+asyncpg://interroai_app:INTERROAI_APP_DB_PASSWORD@localhost:5432/interroai
INTERROAI_MIGRATIONS_DATABASE_URL=postgresql+asyncpg://postgres:POSTGRES_PASSWORD@localhost:5432/interroai

# The emulator's fixed connection string (from Microsoft's emulator docs).
INTERROAI_SERVICEBUS_CONNECTION_STRING=Endpoint=sb://localhost;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;
INTERROAI_SERVICEBUS_QUEUE=index-jobs

# Azurite's well-known development account — published by Microsoft, not a secret.
INTERROAI_BLOB_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;
INTERROAI_BLOB_CONTAINER=uploads

# The platform OpenAI key the API and worker use on everyone's behalf.
INTERROAI_OPENAI_API_KEY=

# A GitHub OAuth App for development, with the callback URL
#   http://localhost:8080/auth/github/callback
INTERROAI_GITHUB_CLIENT_ID=
INTERROAI_GITHUB_CLIENT_SECRET=
INTERROAI_PUBLIC_API_URL=http://localhost:8080

# Signs access tokens. Generate with:  openssl rand -hex 32
INTERROAI_JWT_SECRET=

# Comma-separated GitHub logins allowed to sign in. Empty admits nobody.
INTERROAI_ALLOWED_GITHUB_LOGINS=Alex110506
INTERROAI_DAILY_TOKEN_QUOTA=200000
INTERROAI_DAILY_REQUEST_QUOTA=500

# ── Local runtime ────────────────────────────────────────────────────────────
# Which Cloud API the desktop runtime signs in to and indexes through.
INTERROAI_API_URL=http://localhost:8080

# ── Optional tuning (defaults shown) ─────────────────────────────────────────
# INTERROAI_LOG_FORMAT=text              # the images set json: one object per line
# INTERROAI_CHAT_MODELS=gpt-5.6-sol,gpt-5.6-terra,gpt-5.6-luna
# INTERROAI_MAX_UPLOAD_BYTES=25000000
# INTERROAI_MAX_REQUEST_BYTES=8000000
# Database connections per process. Every replica of the API and the worker
# shares the server's allowance (a Postgres B1ms permits 35 user connections).
# The worker defaults to 2 + 2, the API to 5 + 5.
# INTERROAI_DATABASE_POOL_SIZE=5
# INTERROAI_DATABASE_MAX_OVERFLOW=5
# Requests per minute, per user (sign-in: per client address).
# INTERROAI_SIGN_IN_PER_MINUTE=30
# INTERROAI_CHAT_PER_MINUTE=60
# INTERROAI_SEARCH_PER_MINUTE=120
# INTERROAI_SYNC_PER_MINUTE=30
# INTERROAI_UPLOADS_PER_MINUTE=30
